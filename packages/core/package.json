{
  "name": "@unrift/core",
  "version": "0.0.0",
  "description": "",
  "private": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "bin"
  ],
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "types": "./dist/esm/index.d.ts"
    },
    "./run": {
      "import": "./dist/esm/run.js",
      "types": "./dist/esm/run.d.ts"
    }
  },
  "bin": {
    "unrift": "./bin/unrift.mjs"
  },
  "scripts": {
    "build": "pnpm build:esm && node scripts/write-cjs-shim.js",
    "build:esm": "tsc -p tsconfig.build.esm.json && node scripts/patch-esm-extensions.js",
    "clean": "rm -rf ./dist",
    "compile": "tsc -p tsconfig.build.json && node scripts/patch-esm-extensions.js",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm test:internal && pnpm test:fail && pnpm test:bail && pnpm test:only",
    "test:bail": "node bin/unrift.mjs --config ./test/bail/unrift.outer.config.ts",
    "test:fail": "node bin/unrift.mjs --config ./test/fail/unrift.outer.config.ts",
    "test:hooks": "node bin/unrift.mjs --config ./test/hooks/unrift.outer.config.ts",
    "test:internal": "node bin/unrift.mjs --config ./test/internal/unrift.config.ts",
    "test:only": "node bin/unrift.mjs --config ./test/only/unrift.outer.config.ts",
    "test:orig": "node bin/unrift.mjs",
    "test:publish": "pnpm clean && pnpm build && pnpm pack --pack-destination ./dist-pack",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "keywords": [],
  "author": "elijah kotyluk <elijah@elijahkotyluk.com>",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "esbuild": "^0.27.2"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
