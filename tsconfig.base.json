{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["esnext"],
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    // "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["@types/node"],
    "noEmit": false,
    "strictNullChecks": true,
    "skipDefaultLibCheck": true
    // Note: no `paths` here on purpose. Per-package build configs inherit this
    // base and must resolve `@unrift/core` from node_modules (the built
    // package), not from source — otherwise the wrapper build drags core's
    // source in, outside its rootDir. Editor/dev path mapping lives in the
    // root tsconfig.json instead.
    // "moduleDetection": "force",
    // "isolatedModules": false,
  },
  "ts-node": {
    // Tell ts-node CLI to install the --loader automatically
    "esm": true
  },
  "exclude": ["node_modules"]
}
